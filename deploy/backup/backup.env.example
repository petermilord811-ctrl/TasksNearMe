# Settings for the nightly backup (docs/runbooks/backup-and-restore.md). On the server this file is
# /etc/tasksnearme-backup/backup.env, owned by root, mode 600. These settings are the backup's own, never the app's:
# they stay out of preview.env, so the app can't reach the backup bucket. An empty value means not set.

# The database to back up, inside its Postgres container, and a superuser there (the image's POSTGRES_USER).
BACKUP_DATABASE=tasksnearme_preview
BACKUP_PG_CONTAINER=tasksnearme-db
BACKUP_PG_USER=tnm

# The uploaded files (FILE_STORAGE=local). Empty: none (for example once uploads live in R2).
BACKUP_UPLOADS_DIR=/srv/tasksnearme-preview/uploads
# Settings files kept with the backup, encrypted like the rest (absolute paths, separated by spaces or commas).
# preview.env holds FIELD_ENCRYPTION_KEY, without which a restored database's addresses can't be read.
BACKUP_CONFIG_FILES=/srv/tasksnearme-preview/preview.env /etc/caddy/Caddyfile
# Which release was running, written into the backup's manifest.
BACKUP_REVISION_FILE=/srv/tasksnearme-preview/current/REVISION

# The owner's public key: every file is encrypted to it, and only the matching private key (which never comes to this
# server) can decrypt a backup.
BACKUP_PUBLIC_KEY=/etc/tasksnearme-backup/backup-public-key.asc

# A copy on this server, for quick restores after a mistake (it's lost with the server). Empty: none.
BACKUP_LOCAL_DIR=/var/backups/tasksnearme
BACKUP_LOCAL_KEEP_DAILY=3
BACKUP_LOCAL_KEEP_WEEKLY=0
BACKUP_LOCAL_KEEP_MONTHLY=0

# The off-site copy: an R2 bucket used for nothing else, with an API token allowed only that bucket (Object Read &
# Write). Empty BACKUP_R2_BUCKET: no off-site copy.
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Another S3-compatible endpoint instead of https://<account id>.r2.cloudflarestorage.com (rarely needed).
BACKUP_R2_ENDPOINT=
# The folder in the bucket.
BACKUP_R2_PREFIX=tasksnearme-preview
BACKUP_R2_KEEP_DAILY=7
BACKUP_R2_KEEP_WEEKLY=4
BACKUP_R2_KEEP_MONTHLY=0

# Where the encrypted files are put together before they're stored (default: BACKUP_LOCAL_DIR/.work, else /tmp).
BACKUP_WORK_DIR=
# Called after a backup fully succeeded (a dead man's switch, such as a Healthchecks.io check): the monitor tells
# you when a day passes without it. Keep it secret: anyone with it could report a success.
BACKUP_HEARTBEAT_URL=
