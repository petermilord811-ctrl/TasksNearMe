# Copy to .env.local (git-ignored). Dev-only values; production uses real secrets.

# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://tnm:tnm_dev_password@localhost:54329/tasksnearme
TEST_DATABASE_URL=postgres://tnm:tnm_dev_password@localhost:54329/tasksnearme_test

# App URL used for auth callbacks and links
APP_URL=http://localhost:3000

# The market the home page shows (a markets.slug), so another city can launch without code changes. Empty: gainesville.
DEFAULT_MARKET_SLUG=

# Dev server reached through a reverse proxy (e.g. Caddy on a VPS): its public hostname, no scheme or port.
# Allows Next's dev assets, Server Actions and Better Auth from that host. Leave empty locally.
DEV_PUBLIC_HOST=

# Search engines (src/shared/search-indexing.ts). Leave empty: the live site (a production build whose APP_URL is
# https://tasksnearme.com) follows LIVE_SITE_INDEXING in that file, and every other copy stays out of search.
# Set off, site or on only to override that, e.g. to see the sitemap with its listings on a development server.
SEARCH_INDEXING=

# 'use cache' tag invalidations are shared through Postgres, so every web instance sees them
# (cache-handlers/shared-tags.mjs). off: Next's built-in handler, for one instance only. Empty: shared.
SHARED_CACHE_HANDLER=

# Better Auth secret (any long random string in development)
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef

# Field encryption for exact addresses (base64-encoded 32-byte key; dev value below)
FIELD_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWZvci1sb2NhbC10ZXN0aW5nISE=

# Providers run as fakes unless keys are present (Phase 10). Leave empty in development.
# Stripe: the secret key turns on Stripe Identity (unless Persona is set, below); payments also need the publishable key (pk_…), which the card
# field in the browser uses. Use test keys outside production. The webhook endpoint is <APP_URL>/api/webhooks/stripe
# (identity.verification_session.* and payment_intent.* events), signed with STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# A Connect webhook (events on connected accounts: account.updated, payout.*) at the same URL has its own secret.
STRIPE_CONNECT_WEBHOOK_SECRET=
# The Stripe check (STRIPE_TEST_CHECK=1 npm run test:stripe, tests/stripe) reads test keys (sk_test_…, pk_test_…) from
# .env.stripe-test, not from here: keys in .env.local turn Stripe on for the dev server, e2e and every test:db file.

# Persona, the ID check's double check after our own photos (and clients' risk-triggered checks). All three set:
# Persona replaces Stripe Identity. Use a sandbox API key (persona_sandbox_…) outside production. The inquiry
# template (itmpl_…) is a government ID and selfie check. The webhook is <APP_URL>/api/webhooks/persona,
# subscribed to the inquiry events (completed, approved, declined, failed, expired, marked-for-review) and
# signed with the endpoint's secret (wbhsec_…).
PERSONA_API_KEY=
PERSONA_INQUIRY_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=

# Background checks through Checkr's hosted invitation (people give their SSN and consent to Checkr, never to us).
# Both set: Checkr replaces the stand-in at /dev/providers/background. CHECKR_PACKAGE is the package's slug in
# Checkr; results arrive at <APP_URL>/api/webhooks/checkr, signed with the API key.
CHECKR_API_KEY=
CHECKR_PACKAGE=

# Writing help and AI search: "Help me describe this" when posting, "Write it for me" on a helper's profile and
# offer message, the dashboard's AI search and the home page's assistant (docs/integration-points.md). A load balancer
# over free models answers (src/integrations/ai/balancer.ts; the owner's choice, 2026-11-21: free models only): each
# request goes to the first model, in AI_PROVIDERS order, that has room under its free allowance and works; a model at
# its limit is skipped until it resets. Every model has its own allowance, so GEMINI_MODEL, KIMI_MODEL and GROQ_MODEL
# each take one model or several, comma-separated. With no key at all, development and tests use rule-based stand-ins
# and production doesn't offer these. Phone numbers, emails, links and street addresses in people's text are masked
# before any model sees it.
#
# The order. Empty: gemini,kimi,groq (free first, Groq last: its allowance is the smallest). Add claude to use Claude
# too (paid: ANTHROPIC_API_KEY below).
AI_PROVIDERS=
# Gemini's free tier, with a key from Google AI Studio. Google may use what the free tier is sent to improve its
# products, and people may review it: it never sees documents, and contact details are masked first. Empty defaults:
# GEMINI_MODEL gemini-3.5-flash-lite,gemini-3-flash-preview, GEMINI_TIMEOUT_SECONDS 20, GEMINI_BASE_URL Google's
# v1beta API (always reached over IPv4: Google refuses this server's IPv6 addresses).
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=
GEMINI_TIMEOUT_SECONDS=
# Kimi (Moonshot AI) through NVIDIA's API catalog: an nvapi- key from build.nvidia.com. The free key is for trials
# only, never production or real people's data (NVIDIA API Trial Terms of Service §1.2, §1.4, §4.3), so a production
# build ignores KIMI_API_KEY unless KIMI_IN_PRODUCTION=yes, which you set only once the key has a paid plan. Empty
# defaults: KIMI_MODEL moonshotai/kimi-k3.1-pro, KIMI_BASE_URL https://integrate.api.nvidia.com/v1, and
# KIMI_TIMEOUT_SECONDS 90 (the free tier took 28–74 s an answer on 2026-11-20).
KIMI_API_KEY=
KIMI_MODEL=
KIMI_BASE_URL=
KIMI_TIMEOUT_SECONDS=
KIMI_IN_PRODUCTION=
# Groq, with a gsk_ key from console.groq.com: fast (under a second), with the smallest free allowance (about 1,000
# requests and 200,000 tokens a day, and 8,000 tokens a minute, per model), so it comes last. It keeps no request data
# by default (zero data retention can be switched on in its console). Empty defaults: GROQ_MODEL
# openai/gpt-oss-120b,openai/gpt-oss-20b, GROQ_TIMEOUT_SECONDS 20, GROQ_BASE_URL https://api.groq.com/openai/v1.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=
GROQ_TIMEOUT_SECONDS=

# Claude: paid, so the balancer asks it only when AI_PROVIDERS names claude (and the document readers use it only
# with DOCUMENT_READER=claude). The model defaults to claude-opus-5-5 at low effort; ANTHROPIC_MODEL=claude-haiku-5-5
# costs less.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Who reads ID photos and proofs of address for the trust team. Empty (the default, every environment): this
# server's own reader (Tesseract and PDF.js, src/integrations/ocr): no key, no outside service, no network call.
# `claude` sends them to Claude instead, with ANTHROPIC_API_KEY (without the key the server's reader is used, and
# the log says so once).
DOCUMENT_READER=

# Continue with Google / Microsoft (docs/integration-points.md). Empty: development and tests use the stand-in
# account chooser at /dev/oauth/<provider>; production builds don't offer that provider.
# Google redirect URI: <APP_URL>/api/auth/callback/google. Microsoft: <APP_URL>/api/auth/callback/microsoft.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common (personal, work and school accounts; the default), consumers (personal only), or one organization's id.
MICROSOFT_TENANT_ID=

# Email: set ONE of the two provider keys. Both empty: emails land in the dev outbox (/dev/outbox). With a
# key, every email (sign-in and email-change codes, the welcome email, notifications) goes out from EMAIL_FROM.
# Postmark: EMAIL_FROM must be a sender signature or domain verified in Postmark.
POSTMARK_SERVER_TOKEN=
# Resend: EMAIL_FROM can be onboarding@resend.dev to try it (it then delivers only to the Resend account's own
# address); verify a domain in Resend to send to anyone. Outside production every email is also kept in
# /dev/outbox, and reserved test domains (example.test, …) never reach the provider.
RESEND_API_KEY=
EMAIL_FROM=
# Optional: where replies to our emails go (a support inbox).
EMAIL_REPLY_TO=
# Resend webhook signing secret (whsec_…) for /api/webhooks/resend: bounces and spam complaints stop
# notification email to that address. Empty: the endpoint answers 404.
RESEND_WEBHOOK_SECRET=

# Texts (phone codes, and notifications people chose to get by text) through Twilio. Empty: texts land in the
# dev outbox (/dev/outbox), and production refuses to send them. With the keys, outside production every text
# is also kept in /dev/outbox and numbers in the 555 exchange (seeded and test people) are never texted.
# Prefer a Messaging Service (MG…, registered for A2P 10DLC); TWILIO_FROM is a sender number otherwise.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=

# Notifications on a device (Web Push with a VAPID key pair): `npm run push:keys` makes a pair and adds it to
# .env.local. Empty: push is off and the app says so. WEB_PUSH_SUBJECT is the contact push services see (mailto:
# or https:); empty, it's APP_URL when that's https, otherwise mailto:push@example.com.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# The staff on call (src/modules/oncall/pager.ts; docs/runbooks/README.md): safety reports, urgent cases, a job that
# keeps failing and a stuck job runner page these by text and email at any hour, comma-separated (+15555550123,
# oncall@example.com), besides every active trust_safety staff member. Empty: only those staff are paged; with no one
# at all, a page is logged as "nobody to page" and retried. Set both on the live site.
ONCALL_PHONES=
ONCALL_EMAILS=

# Bot checks (Cloudflare Turnstile) on asking for a sign-in code, finishing sign-up and posting a task
# (docs/integration-points.md). Both empty: development and tests use a stand-in that always passes; production
# then refuses those forms until the keys are set. Use the widget's site key and secret key from the Cloudflare
# dashboard (Turnstile → Add widget; hostnames: your domain, plus localhost for development).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# File storage (task photos, profile photos, proofs of address, evidence, data copies) in a private Cloudflare R2
# bucket. Empty: local disk (.data/uploads); production then refuses to store files unless FILE_STORAGE=local
# (a server whose disk lasts). The access key pair comes from an R2 API token with Object Read & Write on the bucket.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: another S3-compatible endpoint (e.g. a jurisdiction-specific R2 one). Empty: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com.
R2_ENDPOINT=
FILE_STORAGE=

# Reward gift cards through Tremendous (sandbox keys start with TEST_). Empty: the stand-in at /dev/gift-cards,
# and production has no gift cards. The campaign holds the catalog and message; the funding source defaults to
# BALANCE (the prepaid balance).
TREMENDOUS_API_KEY=
TREMENDOUS_CAMPAIGN_ID=
TREMENDOUS_FUNDING_SOURCE_ID=
# Optional: the API's address. Empty: testflight.tremendous.com for TEST_ keys, www.tremendous.com otherwise.
TREMENDOUS_API_URL=

# The landing page's map: any MapLibre style URL and its attribution. Empty: OpenFreeMap (free, no key).
MAP_STYLE_URL=
MAP_ATTRIBUTION=

# Address search when posting (docs/integration-points.md): a Mapbox public token (pk.…) without URL
# restrictions (the app calls Mapbox from its server). Free up to 100,000 searches a month. Empty: development and
# tests use fictional sample addresses, and production has no address search.
MAPBOX_TOKEN=
# Google's address search isn't built: leave empty (a value stops the app).
GOOGLE_MAPS_API_KEY=

# Test clock (blueprint 10 §3.1; src/platform/clock): always on in development. A preview or staging build
# made with TEST_CLOCK=1 has it too, and then needs TEST_CLOCK_SECRET (sent as x-test-clock-secret to
# /dev/clock). Production builds without TEST_CLOCK compile it out.
TEST_CLOCK=
TEST_CLOCK_SECRET=

# 1: no background job runner in this server process (notification emails, reminders, expiries). Empty: it runs.
JOBS_DISABLED=
