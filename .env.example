# Copy to .env.local (git-ignored). Dev-only values; production uses real secrets.

# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://tnm:tnm_dev_password@localhost:54329/tasksnearme
TEST_DATABASE_URL=postgres://tnm:tnm_dev_password@localhost:54329/tasksnearme_test

# App URL used for auth callbacks and links
APP_URL=http://localhost:3000

# Better Auth secret (any long random string in development)
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef

# Field encryption for exact addresses (base64-encoded 32-byte key; dev value below)
FIELD_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWZvci1sb2NhbC10ZXN0aW5nISE=

# Providers run as fakes unless keys are present (Phase 10). Leave empty in development.
# Stripe: the secret key turns on Stripe Identity; payments also need the publishable key (pk_…), which the card
# field in the browser uses. Use test keys outside production. The webhook endpoint is <APP_URL>/api/webhooks/stripe
# (identity.verification_session.* and payment_intent.* events), signed with STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# A Connect webhook (events on connected accounts: account.updated, payout.*) at the same URL has its own secret.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Claude for writing help: "Help me describe this" when posting, and "Write it for me" on a helper's profile
# and offer message (docs/integration-points.md). Empty: development and tests use rule-based stand-ins and
# production doesn't offer it. The model defaults to claude-opus-5-5 at low effort; set ANTHROPIC_MODEL to,
# e.g., claude-haiku-5-5 for lower cost and faster answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Continue with Google / Microsoft (docs/integration-points.md). Empty: development and tests use the stand-in
# account chooser at /dev/oauth/<provider>; production builds don't offer that provider.
# Google redirect URI: <APP_URL>/api/auth/callback/google. Microsoft: <APP_URL>/api/auth/callback/microsoft.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common (personal, work and school accounts; the default), consumers (personal only), or one organization's id.
MICROSOFT_TENANT_ID=

# Email: set ONE of the two provider keys. Both empty: emails land in the dev outbox (/dev/outbox). With a
# key, every email (sign-in and email-change codes, the welcome email, notifications) goes out from EMAIL_FROM.
# Postmark: EMAIL_FROM must be a sender signature or domain verified in Postmark.
POSTMARK_SERVER_TOKEN=
# Resend: EMAIL_FROM can be onboarding@resend.dev to try it (it then delivers only to the Resend account's own
# address); verify a domain in Resend to send to anyone. Outside production every email is also kept in
# /dev/outbox, and reserved test domains (example.test, …) never reach the provider.
RESEND_API_KEY=
EMAIL_FROM=
# Optional: where replies to our emails go (a support inbox).
EMAIL_REPLY_TO=
# Resend webhook signing secret (whsec_…) for /api/webhooks/resend: bounces and spam complaints stop
# notification email to that address. Empty: the endpoint answers 404.
RESEND_WEBHOOK_SECRET=

# Texts (phone codes, and notifications people chose to get by text) through Twilio. Empty: texts land in the
# dev outbox (/dev/outbox), and production refuses to send them. With the keys, outside production every text
# is also kept in /dev/outbox and numbers in the 555 exchange (seeded and test people) are never texted.
# Prefer a Messaging Service (MG…, registered for A2P 10DLC); TWILIO_FROM is a sender number otherwise.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=

# File storage (task photos, profile photos, proofs of address, evidence, data copies) in a private Cloudflare R2
# bucket. Empty: local disk (.data/uploads); production then refuses to store files unless FILE_STORAGE=local
# (a server whose disk lasts). The access key pair comes from an R2 API token with Object Read & Write on the bucket.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
FILE_STORAGE=

# The landing page's map: any MapLibre style URL and its attribution. Empty: OpenFreeMap (free, no key).
MAP_STYLE_URL=
MAP_ATTRIBUTION=

# Address search when posting (docs/integration-points.md): a Mapbox public token (pk.…) without URL
# restrictions (the app calls Mapbox from its server). Free up to 100,000 searches a month. Empty: development and
# tests use fictional sample addresses, and production has no address search.
MAPBOX_TOKEN=

# Test clock (blueprint 10 §3.1; src/platform/clock): always on in development. A preview or staging build
# made with TEST_CLOCK=1 has it too, and then needs TEST_CLOCK_SECRET (sent as x-test-clock-secret to
# /dev/clock). Production builds without TEST_CLOCK compile it out.
TEST_CLOCK=
TEST_CLOCK_SECRET=
