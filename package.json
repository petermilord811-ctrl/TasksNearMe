{
  "name": "tasksnearme",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test --project=ui-mobile --project=ui-desktop",
    "e2e": "playwright test --project=app-mobile --project=app-desktop",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:ui": "npm run check && npm run test:ui",
    "wait:handoff": "node scripts/wait-for-handoff.mjs",
    "codex:run": "node scripts/codex-run.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "next-intl": "4.14.10",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
