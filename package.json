{
  "name": "tasksnearme",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "./src/app/**",
    "./src/ui/**/*.tsx",
    "./src/ui/landing/**",
    "./src/ui/previews/**",
    "./src/ui/theme/**",
    "./src/modules/**",
    "./src/platform/**",
    "./src/integrations/**",
    "./src/i18n/**",
    "./src/shared/**",
    "./src/fixtures/**",
    "./src/proxy.ts",
    "./src/instrumentation*.ts",
    "./instrumentation*.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "start": "next start",
    "e2e:build": "TNM_E2E_BUILD=1 next build",
    "e2e:serve": "APP_URL=http://localhost:3300 next start --hostname localhost --port 3300",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "typecheck": "next typegen && NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test --project=ui-mobile --project=ui-desktop",
    "e2e": "playwright test --project=app-mobile --project=app-desktop",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:ui": "npm run check && npm run test:ui",
    "i18n:check": "node scripts/i18n-check.mjs es",
    "wait:handoff": "node scripts/wait-for-handoff.mjs",
    "codex:run": "node scripts/codex-run.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose stop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/scripts/cli.ts migrate",
    "db:seed": "tsx db/scripts/cli.ts seed",
    "db:demo": "tsx db/scripts/cli.ts demo",
    "db:reset": "tsx db/scripts/cli.ts reset",
    "staff:setup-code": "tsx db/scripts/cli.ts staff-setup-code",
    "push:keys": "node scripts/push-keys.mjs",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:stripe": "vitest run --config vitest.stripe.config.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@better-auth/passkey": "1.7.20",
    "@hookform/resolvers": "7.0.5",
    "@techstark/opencv-js": "5.0.0-release.1",
    "@tesseract.js-data/eng": "1.0.0",
    "better-auth": "1.7.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.71.0",
    "maplibre-gl": "^6.18.0",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "next-intl": "4.14.10",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "7.0.0",
    "three": "0.187.0",
    "unpdf": "2.1.0",
    "vaul": "1.1.2",
    "zod": "4.6.7",
    "zxing-wasm": "3.1.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
